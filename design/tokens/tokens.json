{
  "$description": "Lost in Preparation design tokens. Single source of truth. tokens.css mirrors these values as CSS custom properties; tailwind.config.ts maps Tailwind utilities onto those properties. Contrast ratios (WCAG 2.x) are recorded beside each foreground so the build agent can re-check after any change.",
  "$version": "1.0.0-phase1",

  "color": {
    "$description": "Semantic roles only. Components never reference a raw hex. Pairs are listed as fg-on-bg with measured contrast.",
    "light": {
      "paper":         { "value": "#F6F1E7", "role": "Page ground. Warm, low-chroma paper." },
      "surface":       { "value": "#FCFAF5", "role": "Cards, tables, drawers." },
      "sunken":        { "value": "#EDE6D7", "role": "Wells, table headers, code, track of likelihood bar." },
      "raised":        { "value": "#FFFFFF", "role": "Popovers, tooltips." },
      "ink":           { "value": "#1E1A15", "contrast": { "paper": 15.37, "surface": 16.59, "sunken": 13.92 } },
      "ink-muted":     { "value": "#554C40", "contrast": { "paper": 7.48, "surface": 8.07, "sunken": 6.78 } },
      "ink-subtle":    { "value": "#685E51", "contrast": { "paper": 5.64, "surface": 6.08, "sunken": 5.11 }, "role": "Smallest captions. Lowest text tone allowed." },
      "border":        { "value": "#D8CDB9", "role": "Decorative dividers only (not a control boundary)." },
      "border-strong": { "value": "#8F826D", "contrast": { "paper": 3.34, "surface": 3.61 }, "role": "Control boundaries, ticks. Meets 3:1 non-text." },
      "focus":         { "value": "#2F6DA6", "contrast": { "paper": 4.83, "surface": 5.22 } },
      "overlay":       { "value": "rgba(30,26,21,0.40)", "role": "Drawer scrim." },

      "hist-fg":       { "value": "#8A4513", "contrast": { "paper": 6.34, "surface": 6.84, "hist-bg": 5.63 }, "role": "Historical preparation: text and icons." },
      "hist-bg":       { "value": "#F3E2CC", "role": "Historical preparation: tint behind labels." },
      "hist-solid":    { "value": "#C27A35", "contrast": { "paper": 3.04, "surface": 3.28 }, "role": "Historical range fills. Deliberately LIGHTER than mod-solid (L 0.26 vs 0.09) so the pair separates without hue." },
      "hist-on-solid": { "value": "#1E1A15", "contrast": { "hist-solid": 5.05 } },

      "mod-fg":        { "value": "#1D4E7E", "contrast": { "paper": 7.64, "surface": 8.24, "mod-bg": 6.86 }, "role": "Modern preparation: text and icons." },
      "mod-bg":        { "value": "#DCE7F2" },
      "mod-solid":     { "value": "#23588C", "contrast": { "paper": 6.55 }, "role": "Modern range fills. Darker than hist-solid." },
      "mod-on-solid":  { "value": "#FFFFFF", "contrast": { "mod-solid": 7.38 } },

      "unk-fg":        { "value": "#5C5750", "contrast": { "paper": 6.36, "surface": 6.86, "unk-bg": 5.59 }, "role": "Unknown: neutral, never alarming." },
      "unk-bg":        { "value": "#E7E3DB" },
      "unk-line":      { "value": "#B8B1A5", "role": "Hatch lines for unknown fills." },

      "prov-fg":       { "value": "#5A3F8C", "contrast": { "paper": 7.39, "prov-bg": 6.77 }, "role": "Provisional (AI reference, not human-checked)." },
      "prov-bg":       { "value": "#ECE5F5" },

      "tox-fg":        { "value": "#8A1C24", "contrast": { "paper": 8.21, "tox-bg": 7.35 }, "role": "Toxicity reported / concern. Also used for error states." },
      "tox-bg":        { "value": "#F7E0E0" },
      "tox-solid":     { "value": "#A3262E" },
      "tox-on-solid":  { "value": "#FFFFFF", "contrast": { "tox-solid": 7.31 } }
    },
    "dark": {
      "paper":         { "value": "#15120E" },
      "surface":       { "value": "#1D1914" },
      "sunken":        { "value": "#100E0B" },
      "raised":        { "value": "#26211B" },
      "ink":           { "value": "#EEE7DA", "contrast": { "paper": 15.18, "surface": 14.22, "sunken": 15.67 } },
      "ink-muted":     { "value": "#BDB2A1", "contrast": { "paper": 8.93, "surface": 8.36 } },
      "ink-subtle":    { "value": "#A4998A", "contrast": { "paper": 6.67, "surface": 6.24 } },
      "border":        { "value": "#3A332A" },
      "border-strong": { "value": "#7A6E5C", "contrast": { "paper": 3.75, "surface": 3.51 } },
      "focus":         { "value": "#8FBCE6", "contrast": { "paper": 9.34 } },
      "overlay":       { "value": "rgba(0,0,0,0.55)" },

      "hist-fg":       { "value": "#E8A566", "contrast": { "paper": 8.90, "hist-bg": 6.82 } },
      "hist-bg":       { "value": "#3A2615" },
      "hist-solid":    { "value": "#E3A466", "contrast": { "paper": 8.68 }, "role": "Lighter than mod-solid (L 0.44 vs 0.22)." },
      "hist-on-solid": { "value": "#15120E", "contrast": { "hist-solid": 8.68 } },

      "mod-fg":        { "value": "#8FBCE6", "contrast": { "paper": 9.34, "mod-bg": 7.21 } },
      "mod-bg":        { "value": "#172B40" },
      "mod-solid":     { "value": "#4C86BF", "contrast": { "paper": 4.86 } },
      "mod-on-solid":  { "value": "#15120E", "contrast": { "mod-solid": 4.86 } },

      "unk-fg":        { "value": "#B4AEA4", "contrast": { "paper": 8.47, "unk-bg": 6.75 } },
      "unk-bg":        { "value": "#2A2722" },
      "unk-line":      { "value": "#4A453D" },

      "prov-fg":       { "value": "#C6B2EC", "contrast": { "paper": 9.76, "prov-bg": 7.72 } },
      "prov-bg":       { "value": "#2C2340" },

      "tox-fg":        { "value": "#F2A7AA", "contrast": { "paper": 9.68, "tox-bg": 7.95 } },
      "tox-bg":        { "value": "#3E1A1C" },
      "tox-solid":     { "value": "#E57A80" },
      "tox-on-solid":  { "value": "#1A0B0C", "contrast": { "tox-solid": 6.77 } }
    }
  },

  "font": {
    "family": {
      "serif": { "value": "'EB Garamond', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif", "role": "Historical passages, plant names as written in the source, page titles." },
      "sans":  { "value": "'IBM Plex Sans', 'Segoe UI', system-ui, sans-serif", "role": "All UI and data." },
      "mono":  { "value": "'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace", "role": "IDs, numeric ranges in tables, schema keys." }
    },
    "size": {
      "$description": "Ratio ~1.2 from a 15px data base. Line-height in px. Nothing below 12px.",
      "xs":   { "value": "12px", "lineHeight": "16px" },
      "sm":   { "value": "13px", "lineHeight": "18px" },
      "base": { "value": "15px", "lineHeight": "22px" },
      "md":   { "value": "17px", "lineHeight": "26px", "role": "Reading prose, historical passages (serif)." },
      "lg":   { "value": "20px", "lineHeight": "28px" },
      "xl":   { "value": "24px", "lineHeight": "32px" },
      "2xl":  { "value": "30px", "lineHeight": "38px" },
      "3xl":  { "value": "38px", "lineHeight": "46px" }
    },
    "weight": { "regular": 400, "medium": 500, "semibold": 600 },
    "tracking": { "caps": "0.06em", "normal": "0" }
  },

  "space": {
    "$description": "4px base. Keys match Tailwind spacing keys.",
    "0": "0px", "px": "1px", "0.5": "2px", "1": "4px", "1.5": "6px", "2": "8px", "2.5": "10px", "3": "12px",
    "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px"
  },

  "radius": {
    "none": "0px", "sm": "2px", "DEFAULT": "4px", "md": "6px", "full": "9999px",
    "$description": "Small radii: printed-page restraint. Pills (full) only for status badges and filter chips."
  },

  "elevation": {
    "$description": "Mostly borders, not shadows. Three levels only.",
    "0": { "value": "none", "role": "Flat on paper. Default for cards and tables." },
    "1": { "value": "0 1px 2px rgba(30,26,21,0.08)", "dark": "0 1px 2px rgba(0,0,0,0.5)", "role": "Hover on interactive cards." },
    "2": { "value": "0 4px 16px rgba(30,26,21,0.12)", "dark": "0 4px 16px rgba(0,0,0,0.6)", "role": "Tooltips, popovers." },
    "3": { "value": "0 12px 40px rgba(30,26,21,0.18)", "dark": "0 12px 40px rgba(0,0,0,0.7)", "role": "Drawer." }
  },

  "motion": {
    "duration": { "fast": "120ms", "base": "200ms" },
    "easing": { "standard": "cubic-bezier(0.2, 0, 0, 1)" },
    "$description": "Honoured only when prefers-reduced-motion is not set."
  },

  "layout": {
    "content-max": "1200px",
    "prose-max": "68ch",
    "nav-width": "240px",
    "drawer-width": "480px",
    "breakpoints": { "sm": "640px", "md": "900px", "lg": "1200px" }
  }
}
