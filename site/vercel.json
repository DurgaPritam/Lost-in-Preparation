{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/recipes/",
      "destination": "/atlas/",
      "permanent": true
    },
    {
      "source": "/compare/",
      "destination": "/lab/",
      "permanent": true
    },
    {
      "source": "/audit/",
      "destination": "/docs/#studies",
      "permanent": true
    },
    {
      "source": "/methods/",
      "destination": "/docs/",
      "permanent": true
    },
    {
      "source": "/data/",
      "destination": "/docs/#downloads",
      "permanent": true
    },
    {
      "source": "/case-studies/liquorice/",
      "destination": "/case/liquorice/",
      "permanent": true
    }
  ]
}
