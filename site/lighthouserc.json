{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs out 4517",
      "startServerReadyPattern": "serving",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4517/",
        "http://localhost:4517/recipes/",
        "http://localhost:4517/recipes/pliny-nh_b22_c011_001_r01/",
        "http://localhost:4517/recipes/culpeper-1652_herbal_agrimony_008_r01/",
        "http://localhost:4517/compare/",
        "http://localhost:4517/audit/",
        "http://localhost:4517/hypotheses/",
        "http://localhost:4517/hypotheses/wfo-0000212813-D008107/",
        "http://localhost:4517/case-studies/liquorice/",
        "http://localhost:4517/methods/",
        "http://localhost:4517/data/"
      ],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
