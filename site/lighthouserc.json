{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs out 4517",
      "startServerReadyPattern": "serving",
      "numberOfRuns": 3,
      "url": [
        "http://localhost:4517/",
        "http://localhost:4517/lab/?plant=Salvia%20sclarea&solvent=water&heat=boiled&strained=true&acid=false",
        "http://localhost:4517/lab/?plant=Hyoscyamus%20niger&solvent=water&heat=boiled&strained=true&acid=false",
        "http://localhost:4517/atlas/",
        "http://localhost:4517/recipes/culpeper-1652_herbal_agrimony_008_r01/",
        "http://localhost:4517/recipes/pliny-nh_b20_c099_002_r00/",
        "http://localhost:4517/evidence-gap/",
        "http://localhost:4517/case/liquorice/",
        "http://localhost:4517/planner/",
        "http://localhost:4517/hypotheses/",
        "http://localhost:4517/docs/",
        "http://localhost:4517/credits/"
      ],
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9,
            "aggregationMethod": "median-run"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
