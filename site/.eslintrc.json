{
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": ["lib/data/generated/**", "out/**", ".next/**"],
  "rules": {
    "no-restricted-syntax": ["error",
      { "selector": "JSXAttribute[name.name='className'] Literal[value=/\\[#|\\[(?:rgb|hsl)a?\\(|(?<!underline-offset-)\\[[0-9.]+px\\]|\\b(?:bg|text|border|ring|fill|stroke|outline|decoration|accent)-(?:red|green|blue|gray|slate|zinc|neutral|stone|orange|amber|yellow|lime|emerald|teal|cyan|sky|indigo|violet|purple|fuchsia|pink|rose|black|white)(?:-[0-9]{2,3})?\\b/]",
        "message": "Use design v2 tokens only (DESIGN.md §11.1): no hex/rgb/hsl or raw px arbitrary values (var(--token) is fine; the design's underline-offset-[6px] is the one exception) and no Tailwind default palette classes." },
      { "selector": "JSXAttribute[name.name='className'] TemplateElement[value.raw=/\\[#|\\[(?:rgb|hsl)a?\\(|(?<!underline-offset-)\\[[0-9.]+px\\]/]",
        "message": "Use design v2 tokens only (DESIGN.md §11.1)." }
    ]
  }
}
