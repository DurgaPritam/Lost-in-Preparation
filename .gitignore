# environments & caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
node_modules/
.next/

# raw source downloads: re-created by `python -m lip fetch` (checksums pinned in data/raw/manifest.json)
data/raw/**/*.txt
data/raw/**/*.xml

# large regenerable intermediates (`python -m lip ingest`)
data/interim/*.parquet
# (M1 response caches are COMMITTED: data/interim/m1/raw/ and data/interim/m1/groq_responses/ - hosted models can change or be retired)

# external API response cache (re-created on demand; large)
data/cache/

# local toolchain (xtb via micromamba) and large third-party downloads (re-fetched with checksums)
.tools/
data/raw/logp/*.xlsx

# secrets: API keys live only in the environment or a local .env file
.env
.env.*
!.env.example

# Claude Design handoff archives (kept locally; the extracted handoff is in design/ and design/v2/) and duplicate downloads
design/*.zip
design/* (1).md
