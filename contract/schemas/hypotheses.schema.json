{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lost-in-preparation/contract/1.5/hypotheses.json",
  "title": "hypotheses.json",
  "type": "array",
  "items": {
    "additionalProperties": false,
    "properties": {
      "mock": {
        "default": false,
        "title": "Mock",
        "type": "boolean"
      },
      "rank": {
        "title": "Rank",
        "type": "integer"
      },
      "speciesId": {
        "title": "Speciesid",
        "type": "string"
      },
      "indication": {
        "anyOf": [
          {
            "$ref": "#/$defs/MeshTerm"
          },
          {
            "type": "null"
          }
        ]
      },
      "indicationAsWritten": {
        "title": "Indicationaswritten",
        "type": "string"
      },
      "faithfulPreparation": {
        "description": "preparationKey",
        "title": "Faithfulpreparation",
        "type": "string"
      },
      "faithfulPreparationText": {
        "title": "Faithfulpreparationtext",
        "type": "string"
      },
      "attestationCount": {
        "title": "Attestationcount",
        "type": "integer"
      },
      "profileGap": {
        "$ref": "#/$defs/Interval"
      },
      "gapRanking": {
        "anyOf": [
          {
            "$ref": "#/$defs/GapRanking"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "neverTestedFaithfully": {
        "title": "Nevertestedfaithfully",
        "type": "boolean"
      },
      "toxicityFlag": {
        "$ref": "#/$defs/ToxicityFlag"
      },
      "toxicityNote": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Toxicitynote"
      },
      "caveats": {
        "items": {
          "type": "string"
        },
        "title": "Caveats",
        "type": "array"
      },
      "evidenceTrail": {
        "items": {
          "$ref": "#/$defs/EvidenceItem"
        },
        "title": "Evidencetrail",
        "type": "array"
      }
    },
    "required": [
      "rank",
      "speciesId",
      "indication",
      "indicationAsWritten",
      "faithfulPreparation",
      "faithfulPreparationText",
      "attestationCount",
      "profileGap",
      "neverTestedFaithfully",
      "toxicityFlag",
      "caveats",
      "evidenceTrail"
    ],
    "title": "Hypothesis",
    "type": "object"
  },
  "$defs": {
    "EvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "GapRanking": {
      "additionalProperties": false,
      "properties": {
        "rule": {
          "description": "the ranking rule, e.g. rank by the 5th percentile of the gap over coupled draws",
          "title": "Rule",
          "type": "string"
        },
        "gapP5": {
          "description": "profile gap exceeded in 95% of draws (the ranking key)",
          "title": "Gapp5",
          "type": "number"
        },
        "gapThreshold": {
          "title": "Gapthreshold",
          "type": "number"
        },
        "pGapAboveThreshold": {
          "title": "Pgapabovethreshold",
          "type": "number"
        },
        "compoundsUsed": {
          "title": "Compoundsused",
          "type": "integer"
        },
        "compoundsExcludedWide": {
          "description": "compounds left out: 5th–95th range wider than the rule's limit",
          "title": "Compoundsexcludedwide",
          "type": "integer"
        },
        "rankByMedianGap": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "comparison only; not used for ranking",
          "title": "Rankbymediangap"
        }
      },
      "required": [
        "rule",
        "gapP5",
        "gapThreshold",
        "pGapAboveThreshold",
        "compoundsUsed",
        "compoundsExcludedWide"
      ],
      "title": "GapRanking",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "value",
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "MeshTerm": {
      "additionalProperties": false,
      "properties": {
        "meshId": {
          "title": "Meshid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "meshId",
        "label"
      ],
      "title": "MeshTerm",
      "type": "object"
    },
    "ToxicityFlag": {
      "enum": [
        "toxic_reported",
        "concern_reported",
        "no_toxicity_reported",
        "data_lacking",
        "unknown",
        "known_toxic",
        "none_known"
      ],
      "title": "ToxicityFlag",
      "type": "string"
    }
  }
}
