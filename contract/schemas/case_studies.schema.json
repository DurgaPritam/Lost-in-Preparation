      "required": [
        "faithful",
        "modern",
        "rank",
        "rankedOf",
        "gap"
      ],
      "title": "CaseStage",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "value",
        "low",
        "high"
      ],
      "title": "Interval",
      "type": "object"
    },
    "MeshTerm": {
      "additionalProperties": false,
      "properties": {
        "meshId": {
          "title": "Meshid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "meshId",
        "label"
      ],
      "title": "MeshTerm",
      "type": "object"
    }
  }
}
