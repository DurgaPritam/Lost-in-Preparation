    "additionalProperties": false,
    "properties": {
      "mock": {
        "default": false,
        "title": "Mock",
        "type": "boolean"
      },
      "id": {
        "title": "Id",
        "type": "string"
      },
      "title": {
        "title": "Title",
        "type": "string"
      },
      "speciesId": {
        "title": "Speciesid",
        "type": "string"
      },
      "indication": {
        "$ref": "#/$defs/MeshTerm"
      },
      "primaryRecipeId": {
        "title": "Primaryrecipeid",
        "type": "string"
      },
      "recipeQuote": {
        "title": "Recipequote",
        "type": "string"
      },
      "extractedAs": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Extractedas",
        "type": "object"
      },
      "correctedTo": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Correctedto",
        "type": "object"
      },
      "correctedRecipeIds": {
        "items": {
          "type": "string"
        },
        "title": "Correctedrecipeids",
        "type": "array"
      },
      "evidence": {
        "items": {
          "$ref": "#/$defs/CaseEvidence"
        },
        "title": "Evidence",
        "type": "array"
      },
      "before": {
        "$ref": "#/$defs/CaseStage"
      },
      "after": {
        "$ref": "#/$defs/CaseStage"
      },
      "label": {
        "title": "Label",
        "type": "string"
      }
    },
    "required": [
      "id",
      "title",
      "speciesId",
      "indication",
      "primaryRecipeId",
      "recipeQuote",
      "extractedAs",
      "correctedTo",
      "correctedRecipeIds",
      "evidence",
      "before",
      "after",
      "label"
