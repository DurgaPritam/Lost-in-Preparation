  "$defs": {
    "CaseEvidence": {
      "additionalProperties": false,
      "properties": {
        "passageId": {
          "title": "Passageid",
          "type": "string"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "citation": {
          "title": "Citation",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
