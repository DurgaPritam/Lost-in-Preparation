        "sourceId",
        "citation",
        "text"
      ],
      "title": "CaseEvidence",
      "type": "object"
    },
    "CaseStage": {
      "additionalProperties": false,
      "properties": {
        "faithful": {
          "title": "Faithful",
          "type": "string"
        },
        "modern": {
          "title": "Modern",
          "type": "string"
        },
        "rank": {
          "title": "Rank",
          "type": "integer"
        },
        "rankedOf": {
          "title": "Rankedof",
          "type": "integer"
        },
        "gap": {
