{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lost-in-preparation/contract/1.9/profiles.index.json",
  "title": "profiles.index.json",
  "type": "array",
  "items": {
    "additionalProperties": false,
    "properties": {
      "mock": {
        "default": false,
        "title": "Mock",
        "type": "boolean"
      },
      "speciesId": {
        "title": "Speciesid",
        "type": "string"
      },
      "acceptedName": {
        "title": "Acceptedname",
        "type": "string"
      },
      "file": {
        "description": "path relative to site-data/, e.g. profiles/wfo-0000134589.json",
        "title": "File",
        "type": "string"
      },
      "preparations": {
        "title": "Preparations",
        "type": "integer"
      },
      "compounds": {
        "title": "Compounds",
        "type": "integer"
      },
      "toxicityFlag": {
        "$ref": "#/$defs/ToxicityFlag",
        "default": "unknown"
      },
      "toxicityNote": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Toxicitynote"
      },
      "toxicityEvidence": {
        "anyOf": [
          {
            "$ref": "#/$defs/ToxicityEvidence"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "speciesId",
      "acceptedName",
      "file",
      "preparations",
      "compounds"
    ],
    "title": "ProfileIndexEntry",
    "type": "object"
  },
  "$defs": {
    "ToxicityEvidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "quote": {
          "description": "one verbatim sentence, re-checked against the fetched source",
          "title": "Quote",
          "type": "string"
        },
        "licence": {
          "title": "Licence",
          "type": "string"
        },
        "basis": {
          "description": "e.g. ai_drafted_unverified",
          "title": "Basis",
          "type": "string"
        },
        "verifiedBy": {
          "default": "",
          "title": "Verifiedby",
          "type": "string"
        }
      },
      "required": [
        "source",
        "url",
        "quote",
        "licence",
        "basis"
      ],
      "title": "ToxicityEvidence",
      "type": "object"
    },
    "ToxicityFlag": {
      "enum": [
        "toxic_reported",
        "concern_reported",
        "no_toxicity_reported",
        "data_lacking",
        "unknown",
        "known_toxic",
        "none_known"
      ],
      "title": "ToxicityFlag",
      "type": "string"
    }
  }
}
