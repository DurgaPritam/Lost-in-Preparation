{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lost-in-preparation/contract/1.7/metrics.json",
  "title": "Metrics",
  "$defs": {
    "AuditV2Section": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "protocol": {
          "title": "Protocol",
          "type": "string"
        },
        "overallFidelity": {
          "$ref": "#/$defs/Metric"
        },
        "overallNotFaithfulShare": {
          "$ref": "#/$defs/Metric"
        },
        "perVariableFidelity": {
          "additionalProperties": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Pervariablefidelity",
          "type": "object"
        },
        "solventWineCutoffSensitivity": {
          "additionalProperties": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Solventwinecutoffsensitivity",
          "type": "object"
        },
        "units": {
          "title": "Units",
          "type": "integer"
        },
        "unknownUnits": {
          "title": "Unknownunits",
          "type": "integer"
        },
        "noModernAnalogueUnits": {
          "title": "Nomodernanalogueunits",
          "type": "integer"
        },
        "eligibleStudies": {
          "title": "Eligiblestudies",
          "type": "integer"
        },
        "pairsWithRecords": {
          "title": "Pairswithrecords",
          "type": "integer"
        },
        "pairs": {
          "title": "Pairs",
          "type": "integer"
        }
      },
      "required": [
        "label",
        "protocol",
        "overallFidelity",
        "overallNotFaithfulShare",
        "perVariableFidelity",
        "solventWineCutoffSensitivity",
        "units",
        "unknownUnits",
        "noModernAnalogueUnits",
        "eligibleStudies",
        "pairsWithRecords",
        "pairs"
      ],
      "title": "AuditV2Section",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "result": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "sourceFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcefile"
        }
      },
      "required": [
        "status"
      ],
      "title": "CheckResult",
      "type": "object"
    },
    "ExtractionMetrics": {
      "additionalProperties": false,
      "properties": {
        "run": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionRun"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the LLM run the metrics describe; null until a run exists"
        },
        "overall": {
          "additionalProperties": {
            "$ref": "#/$defs/PRF"
          },
          "description": "per field, all strata",
          "title": "Overall",
          "type": "object"
        },
        "bySource": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/PRF"
            },
            "type": "object"
          },
          "description": "stratum -> field -> PRF",
          "title": "Bysource",
          "type": "object"
        },
        "recipeDetection": {
          "additionalProperties": {
            "$ref": "#/$defs/PRF"
          },
          "description": "stratum or 'overall' -> PRF",
          "title": "Recipedetection",
          "type": "object"
        },
        "spanRejectionRate": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "overall",
        "bySource",
        "recipeDetection",
        "spanRejectionRate"
      ],
      "title": "ExtractionMetrics",
      "type": "object"
    },
    "ExtractionRun": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "modelVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Modelversion"
        },
        "decoding": {
          "additionalProperties": true,
          "default": {},
          "title": "Decoding",
          "type": "object"
        },
        "promptVersion": {
          "title": "Promptversion",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "promptVersion"
      ],
      "title": "ExtractionRun",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Low"
        },
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "High"
        },
        "n": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N"
        },
        "sourceFile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sourcefile"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "status"
      ],
      "title": "Metric",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "computed",
        "not_computed"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "PRF": {
      "additionalProperties": false,
      "properties": {
        "precision": {
          "$ref": "#/$defs/Metric"
        },
        "recall": {
          "$ref": "#/$defs/Metric"
        },
        "f1": {
          "$ref": "#/$defs/Metric"
        }
      },
      "required": [
        "precision",
        "recall",
        "f1"
      ],
      "title": "PRF",
      "type": "object"
    },
    "ProvisionalSection": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "description": "silver_ai_reference | ai_drafted_unverified | ai_curated_literature_reference",
          "title": "Basis",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "extraction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExtractionMetrics"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/Metric"
          },
          "default": {},
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "basis",
        "label"
      ],
      "title": "ProvisionalSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "default": "1.7",
      "title": "Contractversion",
      "type": "string"
    },
    "generatedAt": {
      "title": "Generatedat",
      "type": "string"
    },
    "pipelineVersion": {
      "title": "Pipelineversion",
      "type": "string"
    },
    "mock": {
      "default": false,
      "title": "Mock",
      "type": "boolean"
    },
    "extraction": {
      "$ref": "#/$defs/ExtractionMetrics"
    },
    "interAnnotatorAgreement": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "description": "field -> Cohen's kappa",
      "title": "Interannotatoragreement",
      "type": "object"
    },
    "nameResolution": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Nameresolution",
      "type": "object"
    },
    "logPError": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "title": "Logperror",
      "type": "object"
    },
    "headlineMatchRate": {
      "$ref": "#/$defs/Metric"
    },
    "artemisininCheck": {
      "$ref": "#/$defs/CheckResult"
    },
    "reportingGap": {
      "additionalProperties": {
        "$ref": "#/$defs/Metric"
      },
      "description": "v1.6 (P37b): descriptive reporting-gap shares (not hypothesis tests), Wilson 95% CI",
      "title": "Reportinggap",
      "type": "object"
    },
    "auditV2": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuditV2Section"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "v1.6 (P37c): audit v2, pre-registered re-analysis after v1's design flaw"
    },
    "provisional": {
      "additionalProperties": {
        "$ref": "#/$defs/ProvisionalSection"
      },
      "description": "v1.2: PROVISIONAL results against AI-made references; never gold",
      "title": "Provisional",
      "type": "object"
    }
  },
  "required": [
    "generatedAt",
    "pipelineVersion",
    "extraction",
    "interAnnotatorAgreement",
    "nameResolution",
    "logPError",
    "headlineMatchRate",
    "artemisininCheck"
  ],
  "type": "object"
}
